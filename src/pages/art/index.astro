---
import { siteConfig } from "../../config";
import "../../styles/global.css";

const photography = siteConfig.art.photography;
const sketches = siteConfig.art.sketches;
const sports = siteConfig.sports ?? [];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Art, Photography & Sketches by Anas Faiz" />
    <meta name="theme-color" content="#080808" />
    <title>Art & Life — Anas Faiz</title>
  </head>
  <body>

    <!-- ── Header ── -->
    <header id="art-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
      <nav class="mx-auto max-w-7xl px-8 py-5 flex items-center justify-between">
        <a href="/portfolio/" class="font-mono text-sm tracking-widest uppercase text-[var(--text-primary)] opacity-70 hover:opacity-100 transition-opacity duration-300">
          ← Back
        </a>
        <span class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)]">Art & Life</span>
        <div class="flex gap-6">
          <a href="#sketches" class="font-mono text-xs tracking-widest uppercase text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors duration-300">Sketches</a>
          <a href="#photography" class="font-mono text-xs tracking-widest uppercase text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors duration-300">Photos</a>
          <a href="#sports" class="font-mono text-xs tracking-widest uppercase text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors duration-300">Sports</a>
        </div>
      </nav>
    </header>

    <script>
      const header = document.getElementById('art-header');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 60) {
          header?.classList.add('art-header-scrolled');
        } else {
          header?.classList.remove('art-header-scrolled');
        }
      });
    </script>

    <main class="pt-24">

      <!-- ── Hero banner ── -->
      <div class="border-b border-[var(--border)] px-8 sm:px-12 md:px-24 pb-20 pt-12 max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div>
            <span class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)] block mb-4">Anas Faiz — Visual Work</span>
            <h1 class="text-6xl sm:text-7xl md:text-8xl font-bold leading-none tracking-tight text-[var(--text-primary)]">
              Art &<br/><span class="art-page-outline">Life.</span>
            </h1>
          </div>
          <p class="max-w-sm text-base text-[var(--text-secondary)] font-light leading-relaxed md:text-right">
            Photography, sketching, and sport —<br/>
            the quieter side of how I see the world.
          </p>
        </div>
        <div class="mt-10 flex items-center gap-10">
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)]">Sketches</span>
          </div>
          <div class="w-px h-8 bg-[var(--border)]"></div>
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)]">Photographs</span>
          </div>
          <div class="w-px h-8 bg-[var(--border)]"></div>
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)]">Sports</span>
          </div>
        </div>
      </div>

      <!-- ── Sketches ── -->
      {sketches.length > 0 && (
        <section id="sketches" class="py-12 md:py-20 border-b border-[var(--border)] bg-[var(--bg-surface)]">
          <div class="w-full mx-auto px-0 sm:px-8 max-w-[100rem]">
            <div class="flex items-center gap-6 mb-8 px-8">
              <span class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)]">Sketches</span>
              <div class="flex-1 h-px bg-[var(--border)]"></div>
            </div>
            <div class="carousel-wrapper relative group">
              <div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 pb-6 hide-scrollbar px-4 sm:px-8" id="sketches-slider">
                {sketches.map((item, i) => (
                  <div
                    class="carousel-slide flex-none w-full sm:w-[85vw] md:w-[75vw] h-[65vh] md:h-[80vh] snap-center relative flex flex-col items-center justify-center cursor-zoom-in art-cell group/slide"
                    data-src={item.src}
                    data-index={i}
                  >
                    <img
                      src={item.src}
                      alt={item.caption ?? `Sketch ${i + 1}`}
                      class="max-w-full max-h-[calc(100%-4rem)] object-contain transition-transform duration-700 group-hover/slide:scale-[1.02]"
                      loading={i < 2 ? "eager" : "lazy"}
                    />
                    {item.description && (
                      <div class="mt-4 w-full max-w-4xl text-center px-4 sm:px-0">
                        <p class="text-[0.95rem] text-[var(--text-secondary)] font-light">"{item.description}"</p>
                      </div>
                    )}
                    {item.caption && (
                      <div class="absolute top-6 left-1/2 -translate-x-1/2 opacity-0 group-hover/slide:opacity-100 transition-opacity duration-500 pointer-events-none">
                        <p class="font-mono text-xs md:text-sm text-[var(--bg-primary)] bg-[var(--text-primary)] px-5 py-2.5 rounded shadow-xl tracking-widest">{item.caption}</p>
                      </div>
                    )}
                  </div>
                ))}
              </div>
              <button class="slider-btn slider-prev absolute left-2 md:left-6 top-1/2 -translate-y-1/2 bg-[var(--bg-primary)]/80 backdrop-blur-sm border border-[var(--border)] text-[var(--text-primary)] hover:bg-[var(--text-primary)] hover:text-[var(--bg-primary)] w-12 h-12 flex items-center justify-center rounded-full transition-all opacity-0 group-hover:opacity-100 shadow-lg z-10" aria-label="Previous sketch" data-target="sketches-slider">
                <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              </button>
              <button class="slider-btn slider-next absolute right-2 md:right-6 top-1/2 -translate-y-1/2 bg-[var(--bg-primary)]/80 backdrop-blur-sm border border-[var(--border)] text-[var(--text-primary)] hover:bg-[var(--text-primary)] hover:text-[var(--bg-primary)] w-12 h-12 flex items-center justify-center rounded-full transition-all opacity-0 group-hover:opacity-100 shadow-lg z-10" aria-label="Next sketch" data-target="sketches-slider">
                <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </button>
            </div>
          </div>
        </section>
      )}

      <!-- ── Photography ── -->
      {photography.length > 0 && (
        <section id="photography" class="py-12 md:py-20 border-b border-[var(--border)]">
          <div class="w-full mx-auto px-0 sm:px-8 max-w-[100rem]">
            <div class="flex items-center gap-6 mb-8 px-8">
              <span class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)]">Photography</span>
              <div class="flex-1 h-px bg-[var(--border)]"></div>
            </div>
            <div class="carousel-wrapper relative group">
              <div class="carousel-container flex overflow-x-auto snap-x snap-mandatory gap-6 pb-6 hide-scrollbar px-4 sm:px-8" id="photography-slider">
                {photography.map((item, i) => (
                  <div
                    class="carousel-slide flex-none w-full sm:w-[85vw] md:w-[75vw] h-[65vh] md:h-[80vh] snap-center relative flex flex-col items-center justify-center cursor-zoom-in art-cell group/slide"
                    data-src={item.src}
                    data-index={i + sketches.length}
                  >
                    <img
                      src={item.src}
                      alt={item.caption ?? `Photograph ${i + 1}`}
                      class="max-w-full max-h-[calc(100%-4rem)] object-contain transition-transform duration-700 group-hover/slide:scale-[1.02]"
                      loading={i < 2 ? "eager" : "lazy"}
                    />
                    {item.description && (
                      <div class="mt-4 w-full max-w-4xl text-center px-4 sm:px-0">
                        <p class="text-[0.95rem] text-[var(--text-secondary)] font-light">"{item.description}"</p>
                      </div>
                    )}
                    {item.caption && (
                      <div class="absolute top-6 left-1/2 -translate-x-1/2 opacity-0 group-hover/slide:opacity-100 transition-opacity duration-500 pointer-events-none">
                        <p class="font-mono text-xs md:text-sm text-[var(--bg-primary)] bg-[var(--text-primary)] px-5 py-2.5 rounded shadow-xl tracking-widest">{item.caption}</p>
                      </div>
                    )}
                  </div>
                ))}
              </div>
              <button class="slider-btn slider-prev absolute left-2 md:left-6 top-1/2 -translate-y-1/2 bg-[var(--bg-primary)]/80 backdrop-blur-sm border border-[var(--border)] text-[var(--text-primary)] hover:bg-[var(--text-primary)] hover:text-[var(--bg-primary)] w-12 h-12 flex items-center justify-center rounded-full transition-all opacity-0 group-hover:opacity-100 shadow-lg z-10" aria-label="Previous photograph" data-target="photography-slider">
                <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              </button>
              <button class="slider-btn slider-next absolute right-2 md:right-6 top-1/2 -translate-y-1/2 bg-[var(--bg-primary)]/80 backdrop-blur-sm border border-[var(--border)] text-[var(--text-primary)] hover:bg-[var(--text-primary)] hover:text-[var(--bg-primary)] w-12 h-12 flex items-center justify-center rounded-full transition-all opacity-0 group-hover:opacity-100 shadow-lg z-10" aria-label="Next photograph" data-target="photography-slider">
                <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </button>
            </div>
          </div>
        </section>
      )}

      <!-- ── Sports ── -->
      {sports.length > 0 && (
        <section id="sports" class="py-20 md:py-28 px-8 sm:px-12 md:px-24">
          <div class="max-w-7xl mx-auto">
            <div class="flex items-center gap-6 mb-14">
              <span class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)]">Sports & Athletics</span>
              <div class="flex-1 h-px bg-[var(--border)]"></div>
            </div>
            <div class="sports-bento">
              {sports.map((item, index) => (
                <div class={`sports-cell group relative overflow-hidden ${index === 0 ? 'sports-cell--large' : 'sports-cell--small'}`}>
                  <img
                    src={(item.image as any).src ?? item.image}
                    alt={item.title}
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    loading={index === 0 ? "eager" : "lazy"}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-primary)]/90 via-transparent to-transparent"></div>
                  <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
                    <span class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)] block mb-2">
                      {item.category}
                    </span>
                    <h3 class="text-lg sm:text-xl font-semibold text-[var(--text-primary)]">
                      {item.title}
                    </h3>
                    <div class="overflow-hidden max-h-0 group-hover:max-h-20 transition-all duration-500">
                      <p class="text-sm text-[var(--text-secondary)] mt-2 font-light">
                        {item.description}
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- Footer -->
      <footer class="border-t border-[var(--border)] px-8 sm:px-12 md:px-24 py-10 max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <a href="/portfolio/" class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors border-b border-transparent hover:border-[var(--text-primary)] pb-0.5">
          ← Back to Portfolio
        </a>
        <p class="font-mono text-xs text-[var(--text-muted)] tracking-widest">
          © {new Date().getFullYear()} Anas Faiz
        </p>
      </footer>
    </main>

    <!-- ── Lightbox ── -->
    <div id="lightbox" class="lightbox hidden" role="dialog" aria-modal="true" aria-label="Image viewer">
      <button id="lb-close" class="lb-close" aria-label="Close">&times;</button>
      <button id="lb-prev" class="lb-nav lb-prev" aria-label="Previous">&#8592;</button>
      <button id="lb-next" class="lb-nav lb-next" aria-label="Next">&#8594;</button>
      <div class="lb-content">
        <img id="lb-img" src="" alt="" class="lb-img" />
      </div>
    </div>

    <script>
      // Lightbox logic
      const cells = Array.from(document.querySelectorAll('.art-cell'));
      const lightbox = document.getElementById('lightbox')!;
      const lbImg = document.getElementById('lb-img') as HTMLImageElement;
      let current = 0;

      function open(idx: number) {
        current = idx;
        const cell = cells[idx];
        const src = cell.getAttribute('data-src') || '';
        lbImg.src = src;
        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function close() {
        lightbox.classList.add('hidden');
        document.body.style.overflow = '';
      }

      function next() { open((current + 1) % cells.length); }
      function prev() { open((current - 1 + cells.length) % cells.length); }

      cells.forEach((cell, i) => cell.addEventListener('click', () => open(i)));
      document.getElementById('lb-close')!.addEventListener('click', close);
      document.getElementById('lb-next')!.addEventListener('click', next);
      document.getElementById('lb-prev')!.addEventListener('click', prev);
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
      document.addEventListener('keydown', (e) => {
        if (lightbox.classList.contains('hidden')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowRight') next();
        if (e.key === 'ArrowLeft') prev();
      });

      // Carousel slider logic
      document.querySelectorAll('.slider-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation(); // prevent opening lightbox if clicking button over image
          const targetId = btn.getAttribute('data-target');
          if (!targetId) return;
          const container = document.getElementById(targetId);
          if (!container) return;
          
          const isNext = btn.classList.contains('slider-next');
          // scroll by approximately the width of the container
          const scrollAmount = container.clientWidth * 0.8;
          
          container.scrollBy({
            left: isNext ? scrollAmount : -scrollAmount,
            behavior: 'smooth'
          });
        });
      });
    </script>

    <!-- Cloudflare Web Analytics -->
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "bdb69e25e2454d1f9f237bfb8c8feaad"}'></script>
    <!-- End Cloudflare Web Analytics -->

  </body>
</html>

<style>
  .art-page-outline {
    -webkit-text-stroke: 1.5px var(--text-primary);
    color: transparent;
  }

  /* Header scroll state */
  .art-header-scrolled {
    background-color: rgba(8, 8, 8, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  /* ── Carousel Slider ── */
  .hide-scrollbar {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 768px) {
    .slider-btn {
      opacity: 1 !important; /* Always show buttons on mobile devices for discoverability */
      background-color: var(--bg-surface);
    }
  }

  /* ── Sports bento ── */
  .sports-bento {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .sports-bento {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: 320px 280px;
    }
    .sports-cell--large {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  .sports-cell {
    min-height: 220px;
    background: var(--bg-surface);
  }

  /* ── Lightbox ── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox.hidden {
    display: none;
  }

  .lb-content {
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lb-img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
  }

  .lb-close {
    position: fixed;
    top: 24px;
    right: 32px;
    font-size: 32px;
    color: var(--text-secondary);
    background: none;
    border: none;
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s;
    z-index: 1001;
    font-family: sans-serif;
  }
  .lb-close:hover { color: var(--text-primary); }

  .lb-nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: 1px solid var(--border-light);
    color: var(--text-secondary);
    font-size: 22px;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1001;
    transition: all 0.2s;
  }
  .lb-nav:hover {
    border-color: var(--text-primary);
    color: var(--text-primary);
  }
  .lb-prev { left: 24px; }
  .lb-next { right: 24px; }
</style>