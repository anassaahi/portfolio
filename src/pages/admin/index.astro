---
import "../../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin - Anas Faiz</title>
  </head>
  <body class="bg-[var(--bg-primary)] min-h-screen text-[var(--text-primary)] font-sans">
    <div class="max-w-xl mx-auto px-6 py-20">
      <div class="mb-12 border-b border-[var(--border)] pb-8">
        <h1 class="text-3xl font-bold tracking-tight mb-2">Art & Life Admin</h1>
        <p class="font-mono text-xs text-[var(--text-secondary)] tracking-widest uppercase">Local Upload Dashboard</p>
      </div>

      <!-- Login View -->
      <div id="login-view" class="space-y-6">
        <div>
          <label class="block font-mono text-xs text-[var(--text-muted)] tracking-widest uppercase mb-2">Password</label>
          <input 
            type="password" 
            id="password-input" 
            class="w-full bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text-primary)] px-4 py-3 focus:outline-none focus:border-[var(--text-primary)] transition-colors"
            placeholder="Enter password..."
          />
        </div>
        <button 
          id="login-btn"
          class="w-full bg-[var(--text-primary)] text-[var(--bg-primary)] font-mono text-xs tracking-widest uppercase py-4 hover:opacity-90 transition-opacity"
        >
          Login
        </button>
        <p id="login-error" class="text-red-500 font-mono text-xs hidden mt-4">Incorrect password.</p>
      </div>

      <!-- Upload View -->
      <div id="upload-view" class="hidden space-y-8">
        <form id="upload-form" class="space-y-6">
          <div>
            <label class="block font-mono text-xs text-[var(--text-muted)] tracking-widest uppercase mb-2">Image File</label>
            <input 
              type="file" 
              name="image" 
              accept="image/*" 
              required
              class="w-full bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text-primary)] px-4 py-3 file:mr-4 file:py-2 file:px-4 file:border-0 file:text-xs file:font-mono file:bg-[var(--text-primary)] file:text-[var(--bg-primary)] hover:file:opacity-90"
            />
          </div>

          <div>
            <label class="block font-mono text-xs text-[var(--text-muted)] tracking-widest uppercase mb-2">Category</label>
            <select name="category" class="w-full bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text-primary)] px-4 py-3 focus:outline-none appearance-none cursor-pointer">
              <option value="photography">Photography</option>
              <option value="sketches">Sketches</option>
            </select>
          </div>

          <div>
            <label class="block font-mono text-xs text-[var(--text-muted)] tracking-widest uppercase mb-2">Orientation</label>
            <select name="orientation" class="w-full bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text-primary)] px-4 py-3 focus:outline-none appearance-none cursor-pointer">
              <option value="portrait">Portrait</option>
              <option value="landscape">Landscape</option>
            </select>
          </div>

          <div>
            <label class="block font-mono text-xs text-[var(--text-muted)] tracking-widest uppercase mb-2">Description</label>
            <input 
              type="text" 
              name="description" 
              required
              class="w-full bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text-primary)] px-4 py-3 focus:outline-none focus:border-[var(--text-primary)] transition-colors"
              placeholder="E.g. A beautiful sunset..."
            />
          </div>

          <button 
            type="submit"
            id="submit-btn"
            class="w-full bg-[var(--text-primary)] text-[var(--bg-primary)] font-mono text-xs tracking-widest uppercase py-4 hover:opacity-90 transition-opacity"
          >
            Upload to Portfolio
          </button>
        </form>

        <div id="status-message" class="hidden font-mono text-xs p-4 border text-center"></div>
      </div>
    </div>

    <script>
      const passwordInput = document.getElementById('password-input') as HTMLInputElement;
      const loginBtn = document.getElementById('login-btn')!;
      const loginError = document.getElementById('login-error')!;
      const loginView = document.getElementById('login-view')!;
      const uploadView = document.getElementById('upload-view')!;
      
      const uploadForm = document.getElementById('upload-form') as HTMLFormElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const statusMessage = document.getElementById('status-message')!;

      // Simple local password check
      loginBtn.addEventListener('click', () => {
        if (passwordInput.value === 'admin123') {
          loginView.classList.add('hidden');
          uploadView.classList.remove('hidden');
        } else {
          loginError.classList.remove('hidden');
        }
      });

      // Helper to read file as data URL
      const toBase64 = (file: File) => new Promise<string>((resolve, reject) => {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = () => resolve(reader.result as string);
        reader.onerror = error => reject(error);
      });

      // Handle Form Submit
      uploadForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        submitBtn.disabled = true;
        submitBtn.textContent = 'Uploading...';
        statusMessage.className = 'hidden font-mono text-xs p-4 border text-center';

        try {
          const formData = new FormData(uploadForm);
          const imageFile = formData.get('image') as File;
          
          if (!imageFile || imageFile.size === 0) throw new Error("No image selected");
          
          const base64Data = await toBase64(imageFile);
          
          const payload = {
            image: base64Data,
            filename: imageFile.name,
            category: formData.get('category'),
            orientation: formData.get('orientation'),
            description: formData.get('description')
          };

          // Send to Astro endpoint as JSON
          const res = await fetch('/portfolio/api/upload', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload),
          });

          const data = await res.json();

          if (res.ok && data.success) {
            statusMessage.textContent = 'SUCCESS: Image uploaded and config.ts updated!';
            statusMessage.className = 'block font-mono text-xs p-4 border border-green-500/30 bg-green-500/10 text-green-400 text-center';
            uploadForm.reset();
          } else {
            throw new Error(data.error || 'Upload failed');
          }
        } catch (error: any) {
          statusMessage.textContent = 'ERROR: ' + error.message;
          statusMessage.className = 'block font-mono text-xs p-4 border border-red-500/30 bg-red-500/10 text-red-400 text-center';
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Upload to Portfolio';
        }
      });
    </script>
  </body>
</html>
