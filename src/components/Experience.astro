---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{hasExperience && (
  <section id="experience" class="relative py-24 md:py-32 px-8 sm:px-12 md:px-24 border-t border-[var(--border)] bg-[var(--bg-surface)]">

    <!-- Section label -->
    <div class="mb-16 max-w-7xl mx-auto">
      <span class="font-mono text-sm tracking-widest uppercase text-[var(--text-muted)]">04 — Experience</span>
      <div class="mt-4 w-8 h-px bg-[var(--text-muted)]"></div>
    </div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 items-start">

      <div class="lg:col-span-4">
        <h2 class="text-5xl sm:text-6xl md:text-7xl font-bold leading-none tracking-tight text-[var(--text-primary)]">
          Exp<span class="exp-outline">erience.</span>
        </h2>
      </div>

      <div class="lg:col-span-8 space-y-6">
        {siteConfig.experience.map((exp, index) => (
          <div class="group relative p-6 md:p-8 border border-[var(--border)] bg-[var(--bg-primary)] hover:border-[var(--border-light)] transition-all duration-300">

            <!-- Animated left edge accent -->
            <div class="absolute left-0 top-0 bottom-0 w-px bg-[var(--border)] group-hover:bg-[var(--text-primary)] transition-colors duration-300"></div>

            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-5 gap-2">
              <div>
                <h3 class="text-lg sm:text-xl font-semibold text-[var(--text-primary)]">{exp.title}</h3>
                <p class="text-base text-[var(--text-secondary)] font-light mt-0.5">{exp.company}</p>
              </div>
              <span class="font-mono text-xs text-[var(--text-muted)] tracking-widest uppercase whitespace-nowrap mt-1 sm:mt-0">
                {exp.dateRange}
              </span>
            </div>

            <ul class="space-y-3">
              {exp.bullets.map((bullet) => (
                <li class="flex items-start gap-4">
                  <span class="font-mono text-[var(--text-muted)] mt-1 text-xs flex-shrink-0">—</span>
                  <span class="text-base sm:text-lg text-[var(--text-secondary)] font-light leading-relaxed">{bullet}</span>
                </li>
              ))}
            </ul>

            <!-- Bottom border reveal -->
            <div class="absolute bottom-0 left-0 w-0 h-px bg-[var(--text-primary)] group-hover:w-full transition-all duration-500"></div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .exp-outline {
    -webkit-text-stroke: 1px var(--text-primary);
    color: transparent;
  }
</style>
