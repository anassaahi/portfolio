---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
const hasArt = siteConfig.art && (siteConfig.art.photography.length > 0 || siteConfig.art.sketches.length > 0 || (siteConfig.sports?.length ?? 0) > 0);
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <nav class="mx-auto max-w-7xl px-8 py-5 flex items-center justify-between">
    <a href="#hero" class="font-mono text-sm tracking-widest uppercase text-[var(--text-primary)] opacity-70 hover:opacity-100 transition-opacity duration-300">
      AF<span class="text-[var(--text-muted)]">.</span>
    </a>

    <ul class="hidden md:flex items-center gap-8">
      <li>
        <a href="#about" class="nav-link font-mono text-xs tracking-widest uppercase text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors duration-300">
          About
        </a>
      </li>
      {hasProjects && (
        <li>
          <a href="/portfolio/projects" class="nav-link font-mono text-xs tracking-widest uppercase text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors duration-300">
            Projects
          </a>
        </li>
      )}
      {hasArt && (
        <li>
          <a href="/portfolio/art" class="nav-link font-mono text-xs tracking-widest uppercase text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors duration-300">
            Art & Life
          </a>
        </li>
      )}
      {hasExperience && (
        <li>
          <a href="#experience" class="nav-link font-mono text-xs tracking-widest uppercase text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors duration-300">
            Experience
          </a>
        </li>
      )}
      {hasEducation && (
        <li>
          <a href="#education" class="nav-link font-mono text-xs tracking-widest uppercase text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors duration-300">
            Education
          </a>
        </li>
      )}
      <li>
        <a href={`mailto:${siteConfig.social.email}`} class="contact-btn font-mono text-xs tracking-widest uppercase px-4 py-2 border border-[var(--border-light)] text-[var(--text-secondary)] hover:border-[var(--text-primary)] hover:text-[var(--text-primary)] transition-all duration-300">
          Contact
        </a>
      </li>
    </ul>

    <!-- Mobile menu toggle -->
    <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Toggle menu">
      <span class="mobile-bar block w-5 h-px bg-[var(--text-primary)] transition-all duration-300"></span>
      <span class="mobile-bar block w-5 h-px bg-[var(--text-primary)] transition-all duration-300"></span>
      <span class="mobile-bar block w-3 h-px bg-[var(--text-primary)] transition-all duration-300"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--border)] bg-[var(--bg-primary)]">
    <ul class="px-8 py-6 space-y-5">
      <li><a href="#about" class="mobile-nav-link font-mono text-sm tracking-widest uppercase text-[var(--text-secondary)]">About</a></li>
      {hasProjects && <li><a href="/portfolio/projects" class="mobile-nav-link font-mono text-sm tracking-widest uppercase text-[var(--text-secondary)]">Projects</a></li>}
      {hasArt && <li><a href="/portfolio/art" class="mobile-nav-link font-mono text-sm tracking-widest uppercase text-[var(--text-secondary)]">Art & Life</a></li>}
      {hasExperience && <li><a href="#experience" class="mobile-nav-link font-mono text-sm tracking-widest uppercase text-[var(--text-secondary)]">Experience</a></li>}
      {hasEducation && <li><a href="#education" class="mobile-nav-link font-mono text-sm tracking-widest uppercase text-[var(--text-secondary)]">Education</a></li>}
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('header');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileBars = document.querySelectorAll('.mobile-bar');
  let menuOpen = false;

  window.addEventListener('scroll', () => {
    if (window.scrollY > 80) {
      header?.classList.add('header-scrolled');
    } else {
      header?.classList.remove('header-scrolled');
    }
  });

  mobileBtn?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    mobileMenu?.classList.toggle('hidden', !menuOpen);
    if (mobileBars.length >= 3) {
      if (menuOpen) {
        (mobileBars[0] as HTMLElement).style.transform = 'translateY(6px) rotate(45deg)';
        (mobileBars[1] as HTMLElement).style.opacity = '0';
        (mobileBars[2] as HTMLElement).style.transform = 'translateY(-8px) rotate(-45deg)';
        (mobileBars[2] as HTMLElement).style.width = '20px';
      } else {
        mobileBars.forEach((b) => {
          (b as HTMLElement).style.transform = '';
          (b as HTMLElement).style.opacity = '';
          (b as HTMLElement).style.width = '';
        });
      }
    }
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      menuOpen = false;
      mobileMenu?.classList.add('hidden');
      mobileBars.forEach((b) => {
        (b as HTMLElement).style.transform = '';
        (b as HTMLElement).style.opacity = '';
        (b as HTMLElement).style.width = '';
      });
    });
  });
</script>

<style>
  .header-scrolled {
    background-color: rgba(8, 8, 8, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
</style>
