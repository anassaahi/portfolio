---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{hasProjects && (
  <section id="projects" class="relative py-24 md:py-32 px-8 sm:px-12 md:px-24 border-t border-[var(--border)] bg-[var(--bg-surface)]">

    <!-- Section label -->
    <div class="mb-16 max-w-7xl mx-auto">
      <span class="font-mono text-sm tracking-widest uppercase text-[var(--text-muted)]">02 — Projects</span>
      <div class="mt-4 w-8 h-px bg-[var(--text-muted)]"></div>
    </div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 items-start">

      <!-- Heading -->
      <div class="lg:col-span-4">
        <h2 class="text-5xl sm:text-6xl md:text-7xl font-bold leading-none tracking-tight text-[var(--text-primary)]">
          Selected<br/>
          <span class="projects-outline">Work.</span>
        </h2>
      </div>

      <!-- Project cards -->
      <div class="lg:col-span-8 space-y-6">
        {siteConfig.projects.map((project, index) => {
          const Tag = project.link ? "a" : "div";
          const linkProps = project.link
            ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
            : {};

          return (
            <div class="group project-card relative">
              <Tag
                {...linkProps}
                class={`block relative p-6 md:p-8 border border-[var(--border)] bg-[var(--bg-primary)] transition-all duration-400 ${
                  project.link ? "hover:border-[var(--border-light)] hover:bg-[var(--bg-surface-2)]" : ""
                }`}
              >
                <!-- Index + Arrow -->
                <div class="flex justify-between items-start mb-6">
                  <span class="font-mono text-xs text-[var(--text-muted)] tracking-widest">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  {project.link && (
                    <div class="w-8 h-8 border border-[var(--border-light)] flex items-center justify-center group-hover:border-[var(--text-primary)] group-hover:bg-[var(--text-primary)] transition-all duration-300">
                      <svg class="w-3.5 h-3.5 text-[var(--text-muted)] group-hover:text-[var(--bg-primary)] transition-colors duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
                      </svg>
                    </div>
                  )}
                </div>

                <!-- Title -->
                <h3 class="text-xl sm:text-2xl font-semibold text-[var(--text-primary)] mb-3 leading-tight">
                  {project.name}
                </h3>

                <!-- Description -->
                <p class={`text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed font-light ${project.link ? "pr-0" : ""}`}>
                  {project.description}
                </p>

                <!-- Skills -->
                {project.skills && project.skills.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-5">
                    {project.skills.map((skill) => (
                      <span class="font-mono text-xs sm:text-sm px-2.5 py-1.5 border border-[var(--border)] text-[var(--text-muted)] tracking-wide">
                        {skill}
                      </span>
                    ))}
                  </div>
                )}

                <!-- Bottom border reveal on hover -->
                <div class="absolute bottom-0 left-0 w-0 h-px bg-[var(--text-primary)] group-hover:w-full transition-all duration-500"></div>
              </Tag>
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .projects-outline {
    -webkit-text-stroke: 1.5px var(--text-primary);
    color: transparent;
  }
</style>
