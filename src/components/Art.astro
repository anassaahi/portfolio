---
import { siteConfig } from "../config";
import { Image } from "astro:assets";

const hasSports = siteConfig.sports && siteConfig.sports.length > 0;
const hasAny = siteConfig.art.photography.length > 0 || siteConfig.art.sketches.length > 0 || hasSports;
---

{hasAny && (
  <section id="art" class="relative py-24 md:py-32 px-8 sm:px-12 md:px-24 border-t border-[var(--border)]">

    <!-- Section label -->
    <div class="mb-16 max-w-7xl mx-auto">
      <span class="font-mono text-sm tracking-widest uppercase text-[var(--text-muted)]">03 — Art & Life</span>
      <div class="mt-4 w-8 h-px bg-[var(--text-muted)]"></div>
    </div>

    <!-- Section heading -->
    <div class="max-w-7xl mx-auto mb-20">
      <h2 class="text-5xl sm:text-6xl md:text-7xl font-bold leading-none tracking-tight text-[var(--text-primary)]">
        Beyond<br/>
        <span class="art-outline">The Screen.</span>
      </h2>
      <p class="mt-6 max-w-xl text-lg sm:text-xl text-[var(--text-secondary)] font-light leading-relaxed">
        Photography, sketching, and sport — the quieter side of how I see the world.
      </p>
    </div>

    <!-- ── Big CTA Button ── -->
    <div class="max-w-7xl mx-auto">
      <div class="border-t border-[var(--border)] pt-14 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-8">
        <div>
          <p class="font-mono text-sm tracking-widest uppercase text-[var(--text-muted)] mb-2">Beyond the code</p>
          <p class="text-xl sm:text-2xl text-[var(--text-secondary)] font-light">
            Have a look at my personal life and visual work.
          </p>
        </div>
        <a
          href="/portfolio/art"
          id="view-all-art-btn"
          class="view-all-btn group flex items-center gap-4 px-8 py-5 border border-[var(--border-light)] text-[var(--text-primary)] hover:bg-[var(--text-primary)] hover:text-[var(--bg-primary)] transition-all duration-400"
        >
          <span class="font-mono text-sm tracking-widest uppercase">Explore My Art</span>
          <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .art-outline {
    -webkit-text-stroke: 1.5px var(--text-primary);
    color: transparent;
  }

  /* ── CTA button ── */
  .view-all-btn {
    white-space: nowrap;
  }
</style>