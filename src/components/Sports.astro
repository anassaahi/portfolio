---
import { siteConfig } from "../config";
import { Image } from "astro:assets";
---

{siteConfig.sports && siteConfig.sports.length > 0 && (
  <section id="sports" class="py-16 sm:py-24 bg-gray-50">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl lg:mx-0">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Sports & Athletics</h2>
        <p class="mt-4 text-lg text-gray-600">
          A glimpse into my active life, tournaments, and personal achievements outside of coding.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-16 md:grid-cols-6 md:grid-rows-2 lg:gap-6 md:h-[600px]">
        {
          siteConfig.sports.map((item, index) => {
            // Layout logic: Makes the first image massive, and stacks the next two beside it
            let gridClasses = "md:col-span-2 md:row-span-1 h-[300px] md:h-auto"; 
            if (index === 0) gridClasses = "md:col-span-4 md:row-span-2 h-[400px] md:h-auto"; 
            
            return (
              <div class={`group relative overflow-hidden rounded-3xl bg-gray-900 ${gridClasses}`}>
                <Image
                  src={item.image}
                  alt={item.title}
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-110"
                  loading={index === 0 ? "eager" : "lazy"}
                />
                
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent opacity-80 transition-opacity duration-300 group-hover:opacity-100"></div>
                
                <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 transform transition-transform duration-500">
                  <div class="flex items-center gap-x-3 mb-3">
                    <span class="inline-flex items-center rounded-full bg-[var(--accent-color)] px-3 py-1 text-xs font-semibold text-white shadow-sm">
                      {item.category}
                    </span>
                  </div>
                  <h3 class="text-xl sm:text-2xl font-bold text-white mb-2">
                    {item.title}
                  </h3>
                  <div class="grid grid-rows-[0fr] transition-all duration-500 ease-in-out group-hover:grid-rows-[1fr]">
                    <div class="overflow-hidden">
                      <p class="text-sm sm:text-base text-gray-300 pt-2">
                        {item.description}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
)}