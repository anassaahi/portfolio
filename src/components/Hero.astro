---
import { siteConfig } from "../config";
import { Image } from "astro:assets";
import profileImage from "../assets/profile4.jpg"; 
---

<div id="hero" class="relative min-h-screen bg-[var(--bg-primary)] flex flex-col overflow-hidden">

  <!-- Decorative top corner markers (noir editorial style) -->
  <div class="absolute top-20 left-8 font-mono text-xs text-[var(--text-muted)] tracking-widest opacity-60 hidden md:block">
    ↘ PORTFOLIO
  </div>
  <div class="absolute top-20 right-8 font-mono text-xs text-[var(--text-muted)] tracking-widest opacity-60 hidden md:block">
    ©{new Date().getFullYear()}
  </div>

  <!-- Horizontal rule near top -->
  <div class="absolute top-24 left-0 right-0 h-px bg-[var(--border)] opacity-40"></div>

  <!-- Main hero content -->
  <div class="flex-1 flex flex-col md:flex-row items-center justify-center px-8 sm:px-12 md:px-24 pt-32 pb-20 gap-16 md:gap-24 max-w-7xl mx-auto w-full">

    <!-- Left text -->
    <div class="md:w-1/2 flex flex-col gap-6 z-10">
      <div class="hero-tag-line">
        <span class="font-mono text-xs tracking-widest text-[var(--text-muted)] uppercase">— Developer & Artist</span>
      </div>

      <h1 class="hero-name text-7xl sm:text-8xl md:text-[7rem] lg:text-[9rem] font-bold leading-none tracking-tighter text-[var(--text-primary)]">
        {siteConfig.name.split(" ")[0]}<br/>
        <span class="text-outline">{siteConfig.name.split(" ")[1] ?? ""}</span>
      </h1>

      <p class="text-base sm:text-lg text-[var(--text-secondary)] max-w-md leading-relaxed font-light hero-subtitle">
        {siteConfig.title}
      </p>

      <!-- Social links -->
      <div class="flex items-center gap-6 mt-4 hero-socials">
        {siteConfig.social?.email && (
          <a href={`mailto:${siteConfig.social.email}`} aria-label="Email"
            class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors duration-300 border-b border-transparent hover:border-[var(--text-primary)] pb-0.5">
            Email ↗
          </a>
        )}
        {siteConfig.social?.linkedin && (
          <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
            class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors duration-300 border-b border-transparent hover:border-[var(--text-primary)] pb-0.5">
            LinkedIn ↗
          </a>
        )}
        {siteConfig.social?.github && (
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"
            class="font-mono text-xs tracking-widest uppercase text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors duration-300 border-b border-transparent hover:border-[var(--text-primary)] pb-0.5">
            GitHub ↗
          </a>
        )}
      </div>
    </div>

    <!-- Right: profile image -->
    <div class="md:w-1/2 flex justify-center md:justify-end z-10 hero-image-wrap">
      <div class="relative w-64 h-80 sm:w-72 sm:h-96 md:w-80 md:h-[440px] lg:w-96 lg:h-[520px]">
        <!-- Offset border frame -->
        <div class="absolute inset-0 translate-x-4 translate-y-4 border border-[var(--border-light)]"></div>
        <Image
          src={profileImage}
          alt={`${siteConfig.name} — portfolio`}
          class="absolute inset-0 w-full h-full object-cover grayscale contrast-110 z-10"
          loading="eager"
          fetchpriority="high"
        />
        <!-- Bottom caption bar -->
        <div class="absolute bottom-0 left-0 right-0 z-20 px-4 py-3 bg-[var(--bg-primary)]/80 backdrop-blur-sm flex justify-between items-center">
          <span class="font-mono text-[10px] tracking-widest text-[var(--text-muted)] uppercase">
            {siteConfig.name}
          </span>
          <span class="font-mono text-[10px] tracking-widest text-[var(--text-muted)]">
            CS • Dev • Art
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom editorial bar -->
  <div class="border-t border-[var(--border)] px-8 sm:px-12 md:px-24 py-4 flex justify-between items-center max-w-7xl mx-auto w-full">
    <span class="font-mono text-xs text-[var(--text-muted)] tracking-widest uppercase hidden sm:block">
      UET Lahore · Pakistan
    </span>
    <div class="flex items-center gap-3">
      <span class="w-2 h-2 rounded-full bg-[var(--text-muted)] inline-block animate-pulse"></span>
      <span class="font-mono text-xs text-[var(--text-muted)] tracking-widest uppercase">Available for collaboration</span>
    </div>
    <a href="#about" class="font-mono text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors tracking-widest uppercase hidden sm:block">
      Scroll ↓
    </a>
  </div>
</div>

<style>
  .text-outline {
    -webkit-text-stroke: 1.5px var(--text-primary);
    color: transparent;
  }

  .hero-name {
    opacity: 0;
    transform: translateY(30px);
    animation: heroFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }

  .hero-tag-line {
    opacity: 0;
    animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0s forwards;
  }

  .hero-subtitle {
    opacity: 0;
    animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }

  .hero-socials {
    opacity: 0;
    animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.45s forwards;
  }

  .hero-image-wrap {
    opacity: 0;
    animation: heroFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
  }

  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .grayscale {
    filter: grayscale(100%) contrast(1.05);
  }

  .contrast-110 {
    filter: grayscale(100%) contrast(1.1);
  }
</style>